# ==============================================================================
# SMART CAMPUS AI - ROOT ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# Application Environment (development | staging | production)
ENVIRONMENT=production
DEBUG=false

# Backend Server Configuration
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# Database Configuration (MySQL / MariaDB)
USE_MYSQL=true
MYSQL_USER=root
MYSQL_PASSWORD=your_secure_mysql_password
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=smartcampus

# Security & JWT Token Secrets
# Generate using: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=your_cryptographically_secure_jwt_secret_key_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7

# Gemini AI / External LLM API Keys
GEMINI_API_KEY=your_google_gemini_api_key_here
AI_API_KEY_1=optional_backup_api_key_1
AI_API_KEY_2=optional_backup_api_key_2
AI_API_KEY_3=optional_backup_api_key_3

# Frontend Client URL & CORS Configuration
VITE_API_BASE_URL=http://localhost:8000/api
FRONTEND_PORT=5174
